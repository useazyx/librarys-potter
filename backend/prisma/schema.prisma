// Library's Potter — data model.
// Mirrors the tables of the original MySQL script (autores, editoras, livros,
// usuarios, vendas, avaliacoes, problemas) with the relationships made explicit
// and the parts the PHP version kept in the PHP session moved into the database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The three account types of the original site: comum, fornecedor and suporte.
enum Role {
  CUSTOMER
  SUPPLIER
  SUPPORT
}

/// O que a livraria vende. Livro continua sendo o centro; o resto orbita.
enum ProductKind {
  /// Um volume avulso da saga.
  BOOK
  /// Caixa com vários volumes.
  BOX_SET
  /// Edição comemorativa, ilustrada ou de casa.
  SPECIAL_EDITION
  /// Artigo de fã: varinha, colecionável, caneca.
  COLLECTIBLE
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart           Cart?
  orders         Order[]
  reviews        Review[]
  tickets        SupportTicket[] @relation("TicketAuthor")
  handledTickets SupportTicket[] @relation("TicketHandler")
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Author {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  nationality String
  bio         String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  books Book[]

  @@map("authors")
}

model Publisher {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  city      String
  founded   Int?
  createdAt DateTime @default(now())

  books Book[]

  @@map("publishers")
}

model Book {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  kind        ProductKind @default(BOOK)
  /// Nulo em artigos de fã, que não têm ISBN.
  isbn        String?     @unique
  /// Nulos em artigos de fã: uma varinha não tem autor nem editora.
  authorId    String?
  publisherId String?
  publishedAt DateTime?   @db.Date
  price       Decimal     @db.Decimal(10, 2)
  /// Stock is decremented inside the checkout transaction, never by hand.
  stock       Int         @default(0)
  genre       String
  synopsis    String
  excerpt     String?
  coverUrl    String
  pages       Int?
  language    String      @default("Português")
  featured    Boolean     @default(false)
  position    Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author     Author?     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publisher  Publisher?  @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([authorId])
  @@index([publisherId])
  @@index([genre])
  @@index([kind])
  @@map("books")
}

model Review {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One review per reader per book: a second one edits the first.
  @@unique([bookId, userId])
  @@index([bookId])
  @@map("reviews")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  bookId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id        String      @id @default(uuid())
  code      String      @unique
  userId    String
  status    OrderStatus @default(PAID)
  subtotal  Decimal     @db.Decimal(10, 2)
  shipping  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  /// Delivery details are stored flat: the original site had no address book.
  recipient String
  address   String
  city      String
  state     String      @db.Char(2)
  zipCode   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  bookId    String?
  /// Title, price and cover are snapshotted so editing the catalogue never
  /// rewrites what a reader actually bought.
  title     String
  coverUrl  String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// The "problemas" table of the original project, with the support agent tracked.
model SupportTicket {
  id          String        @id @default(uuid())
  code        String        @unique
  userId      String?
  name        String
  email       String
  subject     String
  description String
  urgency     TicketUrgency @default(MEDIUM)
  status      TicketStatus  @default(OPEN)
  resolution  String?
  handledById String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User? @relation("TicketAuthor", fields: [userId], references: [id], onDelete: SetNull)
  handledBy User? @relation("TicketHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("support_tickets")
}

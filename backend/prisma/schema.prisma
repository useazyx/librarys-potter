// Modelo de dados da Library's Potter.
// Segue as tabelas do script MySQL antigo (autores, editoras, livros, usuarios,
// vendas, avaliacoes e problemas), com os relacionamentos declarados e o que o
// PHP guardava na sessão passado para o banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Os três tipos de conta do site antigo: comum, fornecedor e suporte.
enum Role {
  CUSTOMER
  SUPPLIER
  SUPPORT
}

/// O que a loja vende. Os quatro primeiros valores vieram do site antigo e não
/// podem ser renomeados sem migração. Os outros entraram quando a livraria
/// passou a vender também artigos de fã.
enum ProductKind {
  /// Um volume avulso da saga.
  BOOK
  /// Caixa com vários volumes.
  BOX_SET
  /// Edição comemorativa, ilustrada ou de casa.
  SPECIAL_EDITION
  /// Réplica de objeto do filme: vira-tempo, medalhão, taça.
  COLLECTIBLE
  /// Varinha: tem madeira, núcleo e comprimento próprios.
  WAND
  /// Boneco, miniatura ou estatueta.
  FIGURE
  /// Roupa: manto, cachecol, suéter, uniforme.
  APPAREL
  /// Acessório de vestir ou carregar: mochila, joia, chapéu.
  ACCESSORY
  /// Papelaria: caderno, pena, agenda, marcador.
  STATIONERY
  /// Brinquedo ou jogo: blocos de montar, tabuleiro, quebra-cabeça.
  GAME
  /// Casa e decoração: caneca, luminária, estandarte, almofada.
  HOME
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart           Cart?
  orders         Order[]
  reviews        Review[]
  tickets        SupportTicket[] @relation("TicketAuthor")
  handledTickets SupportTicket[] @relation("TicketHandler")
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Author {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  nationality String
  bio         String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  books Book[]

  @@map("authors")
}

model Publisher {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  city      String
  founded   Int?
  createdAt DateTime @default(now())

  books Book[]

  @@map("publishers")
}

model Book {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  kind        ProductKind @default(BOOK)
  /// Nulo em artigo de fã, que não tem ISBN.
  isbn        String?     @unique
  /// Nulos em artigo de fã: varinha não tem autor nem editora.
  authorId    String?
  publisherId String?
  publishedAt DateTime?   @db.Date
  price       Decimal     @db.Decimal(10, 2)
  /// O estoque baixa dentro da transação do checkout, nunca na mão.
  stock       Int         @default(0)
  genre       String
  synopsis    String
  excerpt     String?
  coverUrl    String
  pages       Int?
  language    String      @default("Português")
  featured    Boolean     @default(false)
  position    Int         @default(0)

  /// Marca do produto (Rocco, LEGO, Noble Collection). Vira filtro no catálogo.
  brand       String?
  /// Preço de tabela. Quando existe e é maior que price, o card mostra desconto.
  /// O total do pedido sai sempre de price, nunca daqui.
  compareAtPrice Decimal? @db.Decimal(10, 2)
  /// Casa do produto, quando tem uma. Alimenta o filtro por casa.
  house       String?
  /// Personagem ligado ao produto, quando tem. Vira filtro.
  character   String?
  /// Etiquetas livres (novidade, mais vendido, presente), sem precisar de tabela.
  tags        String[]    @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author     Author?     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  publisher  Publisher?  @relation(fields: [publisherId], references: [id], onDelete: Restrict)
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([authorId])
  @@index([publisherId])
  @@index([genre])
  @@index([kind])
  @@index([house])
  @@index([brand])
  @@map("books")
}

model Review {
  id        String   @id @default(uuid())
  bookId    String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Uma avaliação por pessoa por produto: a segunda edita a primeira.
  @@unique([bookId, userId])
  @@index([bookId])
  @@map("reviews")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  bookId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id        String      @id @default(uuid())
  code      String      @unique
  userId    String
  status    OrderStatus @default(PAID)
  subtotal  Decimal     @db.Decimal(10, 2)
  shipping  Decimal     @default(0) @db.Decimal(10, 2)
  total     Decimal     @db.Decimal(10, 2)
  /// Endereço gravado direto no pedido: o site antigo não tinha agenda de endereços.
  recipient String
  address   String
  city      String
  state     String      @db.Char(2)
  zipCode   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  bookId    String?
  /// Título, preço e capa ficam copiados aqui para que editar o catálogo não
  /// mude o que a pessoa comprou.
  title     String
  coverUrl  String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// A tabela problemas do projeto antigo, agora guardando quem atendeu.
model SupportTicket {
  id          String        @id @default(uuid())
  code        String        @unique
  userId      String?
  name        String
  email       String
  subject     String
  description String
  urgency     TicketUrgency @default(MEDIUM)
  status      TicketStatus  @default(OPEN)
  resolution  String?
  handledById String?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User? @relation("TicketAuthor", fields: [userId], references: [id], onDelete: SetNull)
  handledBy User? @relation("TicketHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("support_tickets")
}
